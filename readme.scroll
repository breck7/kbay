// kbay. Sell your stuff for cash. Neighbors only.
// Build with: scroll build
// Add a listing: put a video in listings/ named "Title - FirstName - Location - Price - Phone.mp4" and send a pull request.
// Shrink videos for slow bandwidth (480p, CRF 28, mono AAC 64k, faststart):
//   ffmpeg -i input.mp4 -vf "scale=-2:480" -c:v libx264 -crf 28 -preset medium -pix_fmt yuv420p -c:a aac -ac 1 -b:a 64k -movflags +faststart "listings/Kids Bike - Breck - Wahiawa - 40 - 808-555-0123.mp4"

listingsParser
 description Print video cards from files in listings/.
 extends abstractScrollParser
 cueFromId
 javascript
  buildHtml() {
   if (!this.isNodeJs()) return this.emptyHtml()
   const fs = require("fs")
   const path = require("path")
   const dir = path.join(this.root.folderPath, "listings")
   if (!fs.existsSync(dir)) return this.emptyHtml()
   const files = fs.readdirSync(dir).filter(name => /\.(mp4|mov|webm|m4v)$/i.test(name) && !name.startsWith(".")).sort((a, b) => a.localeCompare(b, undefined, {sensitivity: "base"}))
   if (!files.length) return this.emptyHtml()
   return `<section class="band listings-band" id="listings"><h2>Listings</h2><div class="listings">${files.map(name => this.cardHtml(name)).join("")}</div></section>`
  }
  emptyHtml() {
   return `<section class="band listings-band" id="listings"><h2>Listings</h2><p class="empty-listings">Nothing listed yet. If you have something a neighbor might need, add a video and send a pull request.</p></section>`
  }
  escape(value) {
   return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")
  }
  parseName(filename) {
   const base = filename.replace(/\.[^.]+$/, "")
   const parts = base.split(" - ")
   if (parts.length < 5) return { ok: false, filename, title: base }
   const phone = parts.pop()
   const price = parts.pop()
   const location = parts.pop()
   const firstName = parts.pop()
   return { ok: true, filename, title: parts.join(" - "), firstName, location, price, phone }
  }
  formatPrice(raw) {
   const compact = String(raw).replace(/\s+/g, "")
   const obo = /obo$/i.test(compact)
   const amount = compact.replace(/obo$/i, "").replace(/[$,]/g, "")
   const number = Number(amount)
   const display = Number.isFinite(number) ? (Number.isInteger(number) ? "$" + number.toLocaleString("en-US") : "$" + number.toFixed(2)) : this.escape(raw)
   return obo ? display + " OBO" : display
  }
  formatPhone(raw) {
   const digits = String(raw).replace(/\D/g, "")
   let display = String(raw).trim()
   let telDigits = digits
   if (digits.length === 10) {
    display = digits.slice(0, 3) + "-" + digits.slice(3, 6) + "-" + digits.slice(6)
    telDigits = "1" + digits
   } else if (digits.length === 11 && digits[0] === "1") {
    display = digits.slice(1, 4) + "-" + digits.slice(4, 7) + "-" + digits.slice(7)
   }
   return { display, href: "tel:+" + telDigits, sms: "sms:+" + telDigits }
  }
  cardHtml(filename) {
   const parsed = this.parseName(filename)
   const src = this.escape("listings/" + filename)
   if (!parsed.ok) return `<article class="listing"><video src="${src}" preload="metadata" controls playsinline></video><div class="meta"><h3>${this.escape(parsed.title)}</h3><p class="note">This filename needs the form Title - FirstName - Location - Price - Phone.mp4</p></div></article>`
   const phone = this.formatPhone(parsed.phone)
   return `<article class="listing"><video src="${src}" preload="metadata" controls playsinline></video><div class="meta"><h3>${this.escape(parsed.title)}</h3><p class="price">${this.formatPrice(parsed.price)}</p><p class="who">${this.escape(parsed.firstName)} · ${this.escape(parsed.location)}</p><p class="phone"><a href="${this.escape(phone.href)}">Call ${this.escape(phone.display)}</a> · <a href="${this.escape(phone.sms)}">Text</a></p></div></article>`
  }

